// Delta LikeC4 — hu-0024 «Integridad verificable del event store».
// Fragmento acotado a la HU: /sync lo reconcilia en los .c4 vivos y remueve los
// tags #delta-new / #delta-changed y los prefijos [NEW] / [CHANGED].
//
// Destino de reconciliación por elemento:
//   · canonicalHash, eventChainReader, postgresEventChainReader, chainVerifier,
//     chainVerificationReport, postgresEventStore, eventStore
//       → apps/ledger/docs/shared-kernel/shared-kernel.c4
//   · idempotencyInputMismatchException, idempotencyPolicy,
//     commandResultInterceptor, commandBus
//       → apps/ledger/docs/shared/shared.c4
//
// Vistas: shared_kernel_verify_chain es nueva; las otras tres reusan viewId
// existente (modify), no se acuñan ids paralelos.

model {
  extend admin.ledger.shared {

    // ---------------------------------------------------------------
    // Nuevos — cadena de hashes y verificación (AC-1..AC-4)
    // ---------------------------------------------------------------

    canonicalHash = component 'canonicalJson + sha256Hex' {
      #delta-new
      technology 'Shared · Pure functions'
      description 'libs/shared: canonicalJson(value) delega en canonicalize@3.0.0 (RFC 8785, JCS) y sha256Hex(input) devuelve hex minúscula de 64 chars. Dos funciones puras, sin I/O ni inyección. Una sola implementación sirve a la cadena (AC-2) y a la idempotencia (AC-5): duplicarla rompería ambas garantías a la vez.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    eventChainReader = component 'EventChainReader' {
      #delta-new
      technology 'Domain · Port'
      description 'abstract class con readChain(userId, fromPosition, limit): ChainRow[] y userIds(): string[]. ChainRow = { globalPosition, eventId, hash, chainInput }. Existe para que el verificador recompute el hash sin que StoredEvent — tipo de dominio — tenga que conocerlo.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    postgresEventChainReader = component 'PostgresEventChainReader' {
      #delta-new
      technology 'Infrastructure · PostgreSQL'
      description 'Lee hash + columnas del hash input desde event_store ordenando por global_position, paginado. Reusa la misma proyección chainHashInput que usa el adaptador al escribir, de modo que verificar y persistir no puedan divergir.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    chainVerifier = component 'ChainVerifier' {
      #delta-new
      technology 'Application · Verifier'
      description 'Recorre la cadena de un usuario (o de todos) recomputando sha256(prev || canónica) y comparando contra el hash persistido. No se detiene en la primera ruptura: reporta todas (AC-4). Solo lee; nunca escribe en el event store.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    chainVerificationReport = component 'ChainVerificationReport' {
      #delta-new
      technology 'Application · DTO'
      description 'Type { ok, usersChecked, eventsChecked, breaks: [{ userId, globalPosition, eventId, expectedHash, actualHash }] }. El CLI lo traduce a exit code 0 (ok) o 1 (al menos una ruptura), para que verify-chain sea usable tal cual como paso de CI.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    // ---------------------------------------------------------------
    // Nuevo — idempotencia estricta (AC-6)
    // ---------------------------------------------------------------

    idempotencyInputMismatchException = component 'IdempotencyInputMismatchException' {
      #delta-new
      technology 'Domain · Exception'
      description 'Extiende DomainConflictException, code IDEMPOTENCY_INPUT_MISMATCH (409). La lanza IdempotencyPolicy cuando una external_ref ya vista llega con inputs distintos. Convive con DUPLICATE_EXTERNAL_REF, que sigue siendo el contrato del puerto ante la violación del índice único.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    // ---------------------------------------------------------------
    // Relaciones (dentro del extend: LikeC4 no resuelve referencias a
    // elementos extend-ed desde afuera del bloque)
    // ---------------------------------------------------------------

    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.canonicalHash 'encadena: sha256(prev || canónica) por evento del batch'
    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.eventStore 'toma pg_advisory_xact_lock(user_id) antes de leer la cabeza'

    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.canonicalHash 'hashea los inputs del command (sin metadatos de transporte)'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'lanza si el hash almacenado difiere'

    admin.ledger.shared.postgresEventChainReader -> admin.ledger.shared.eventChainReader 'implements'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.eventChainReader 'lee la cadena paginada (solo lectura)'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.canonicalHash 'recomputa el hash esperado'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.chainVerificationReport 'returns ChainVerificationReport'
  }

  // ---------------------------------------------------------------
  // Modificados — resaltado + incremento de procedencia. Van al nivel del
  // model (no anidados): LikeC4 no admite extend de un FQN dentro de otro extend.
  // ---------------------------------------------------------------

  extend admin.ledger.shared.eventStore {
    #delta-changed
    metadata {
      changedIn 'hu-0024'
    }
  }

  extend admin.ledger.shared.postgresEventStore {
    #delta-changed
    metadata {
      changedIn 'hu-0024'
    }
  }

  extend admin.ledger.shared.commandBus {
    #delta-changed
    metadata {
      changedIn 'hu-0024'
    }
  }

  extend admin.ledger.shared.idempotencyPolicy {
    #delta-changed
    metadata {
      changedIn 'hu-0024'
    }
  }

  extend admin.ledger.shared.commandResultInterceptor {
    #delta-changed
    metadata {
      changedIn 'hu-0024'
    }
  }
}

views 'Shared Kernel' {

  dynamic view shared_kernel_event_store_batch_append {
    title '[CHANGED] EventStore.append (Postgres, batch INSERT encadenado) · trigger: sync-call'
    description 'AC-1, AC-2, AC-3: el append serializa por usuario con pg_advisory_xact_lock, lee el hash cabeza del usuario por idx_event_user, y encadena los eventos del batch en orden — el hash del evento N depende del N-1 del mismo lote. Todo dentro de la transacción del append, así que el hash y el evento se persisten o se pierden juntos (INV-7).'
    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.eventStore 'pg_advisory_xact_lock(hashtext(user_id))'
    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.eventStore 'SELECT hash … ORDER BY global_position DESC LIMIT 1'
    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.canonicalHash 'chainHashInput(envelope) → sha256(prev || canónica)'
    admin.ledger.shared.postgresEventStore -> admin.ledger.shared.eventStore 'INSERT multi-fila con hash + external_ref_hash'
    autoLayout TopBottom
  }

  dynamic view shared_kernel_verify_chain {
    title '[NEW] Verificar la cadena de hashes · trigger: cli'
    description 'AC-4: ChainVerifier recorre el stream en orden de global_position, recomputa cada hash y lo compara contra el persistido. Sin --userId recorre todos los usuarios. No se detiene en la primera ruptura: reporta todas y sale con exit code 1 si hubo alguna.'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.eventChainReader 'userIds() cuando no se pasó --userId'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.eventChainReader 'readChain(userId, fromPosition, limit)'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.canonicalHash 'sha256(prev || canónica) por evento'
    admin.ledger.shared.chainVerifier -> admin.ledger.shared.chainVerificationReport 'returns report → exit 0 | 1'
    autoLayout LeftRight
  }
}

views 'Shared · HTTP adapter' {

  dynamic view shared_http_idempotent_write {
    title '[CHANGED] POST /api/v1/* con X-External-Ref → replay o 409 · trigger: rest'
    description 'AC-5, AC-6, AC-7: IdempotencyPolicy hashea los inputs del command (Command + userId, sin external_ref, client_id ni metadatos de transporte) y lo compara contra el external_ref_hash del evento ancla. Coincide → replay del CommandResult original con 200 y cabecera Idempotency-Hit: true. No coincide → IDEMPOTENCY_INPUT_MISMATCH (409). El hash viaja al ancla por el AuthContext, que ahora atraviesa el chain de políticas.'
    admin.ledger.shared.externalRefDecorator -> admin.ledger.shared.commandBus 'externalRef en AuthContext'
    admin.ledger.shared.commandBus -> admin.ledger.shared.idempotencyPolicy 'dispatch atraviesa el chain (ctx contextual)'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.canonicalHash 'hash de los inputs del command'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'inputs distintos → 409'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.commandResultInterceptor 'inputs iguales → CommandResult del ancla'
    admin.ledger.shared.commandResultInterceptor -> admin.ledger.shared.commandAcceptedDto '200 + Idempotency-Hit: true + X-Ledger-Stream-Position'
    autoLayout TopBottom
  }

  dynamic view shared_http_map_domain_error {
    title '[CHANGED] Fallo de dominio/puerto → ErrorResponseBody · trigger: rest'
    description 'RF-14 + AC-6 de hu-0024: se suma IDEMPOTENCY_INPUT_MISMATCH (409) a la tabla congelada de códigos. Reparto por capa: el código nuevo es el contrato de IdempotencyPolicy y el único de los dos que el API HTTP emite; DUPLICATE_EXTERNAL_REF se queda como contrato del puerto EventStore ante la violación del índice único.'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'throws IDEMPOTENCY_INPUT_MISMATCH'
    autoLayout TopBottom
  }
}
