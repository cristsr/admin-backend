// C4 Nivel 1 (Context) + Nivel 2 (Container) del sistema admin-back.
// Los componentes de cada modulo (Nivel 3) y sus dynamic views viven en
// apps/<app>/docs/<module>/<module>.c4 y extienden los nodos definidos aca.

specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element app
  element module
  element component
  element store {
    style {
      shape cylinder
    }
  }

  // Taxonomia de triggers (adaptadores primarios). Cada dynamic view se etiqueta
  // con el trigger que la inicia.
  tag rest
  tag cron
  tag queue
  tag domain-event
  tag cli
}

model {
  user = actor 'Usuario' {
    description 'Dueno del ledger: opera cuentas y transacciones.'
  }

  admin = system 'admin-back' {
    description 'Backend de administracion financiera.'

    ledger = app 'Ledger' {
      technology 'NestJS · event-sourcing + CQRS · hexagonal'
      description 'Contabilidad por partida doble con event sourcing.'

      // Shared kernel: piezas transversales que los flujos de todos los modulos
      // referencian. (Detalle completo pendiente en shared-kernel.c4.)
      shared = module 'Shared Kernel' {
        description 'Command/Query bus, event store, base de agregados.'

        commandBus = component 'CommandBus' {
          technology 'Application'
          description 'Despacha commands al handler y persiste eventos.'
        }
        queryBus = component 'QueryBus' {
          technology 'Application'
          description 'Resuelve queries contra las proyecciones.'
        }
        eventStore = store 'EventStore' {
          technology 'PostgreSQL'
          description 'Append-only de eventos de dominio.'
        }
      }
    }
  }

  user -> admin.ledger 'Opera vía HTTP/REST'
}

views {
  view index {
    title 'admin-back — panorama'
    include *
  }

  view ledgerContainers {
    title 'Ledger — contenedores y módulos'
    include admin.ledger, admin.ledger.*
  }
}
