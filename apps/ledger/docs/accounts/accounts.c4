// C4 Nivel 3 — modulo accounts (apps/ledger/src/accounts).
// Extiende admin.ledger (definido en docs/architecture/landscape.c4).

model {
  extend admin.ledger {
    accounts = module 'Accounts' {
      description 'Ciclo de vida de cuentas: apertura, renombre, cierre y lecturas del arbol.'

      // --- Domain ---
      account = component 'Account' {
        technology 'Domain · Aggregate'
        description 'Agregado event-sourced. open / rename / close. Invariantes de moneda y proteccion de cuentas de sistema.'
      }
      accountEvents = component 'Account Events' {
        technology 'Domain · Events'
        description 'AccountOpened · AccountRenamed · AccountClosed.'
      }
      accountException = component 'AccountException' {
        technology 'Domain · Exceptions'
        description 'Jerarquia de excepciones de dominio (7 clases).'
      }

      // --- Application ---
      accountRepository = component 'AccountRepository' {
        technology 'Application · Repository'
        description 'extends EventSourcedRepository<Account>.'
      }
      accountValidation = component 'AccountValidationService' {
        technology 'Application · Service'
        description 'Validacion cruzada INV-3 / INV-4.'
      }
      openHandler = component 'OpenAccountHandler' {
        technology 'Application · CommandHandler'
      }
      renameHandler = component 'RenameAccountHandler' {
        technology 'Application · CommandHandler'
      }
      closeHandler = component 'CloseAccountHandler' {
        technology 'Application · CommandHandler'
      }
      initializeHandler = component 'InitializeLedgerHandler' {
        technology 'Application · CommandHandler'
        description 'Inicializa el ledger: settings + las dos cuentas tecnicas, los tres appends en un unico withTransaction (INV-7). No construye el agregado Account: despacha OpenSystemAccountCommand.'
        metadata {
          introducedIn 'refactor-module-boundaries'
        }
      }
      openSystemHandler = component 'OpenSystemAccountHandler' {
        technology 'Application · CommandHandler'
        description 'Abre una cuenta de sistema (isSystem: true, INV-13). No despacha proyecciones ni valida unicidad de nombre: las despacha el caller, que es quien abre el scope transaccional.'
        metadata {
          introducedIn 'refactor-module-boundaries'
        }
      }
      accountFactsReader = component 'AccountFactsReader' {
        technology 'Application · Port'
        description 'Puerto de lectura: factsOf(userId, accountId) -> { type, currency, isBankMirror }. Lo consume transactions en vez de leer proj_accounts directo.'
        metadata {
          introducedIn 'refactor-module-boundaries'
        }
      }

      // --- Infrastructure ---
      controller = component 'AccountsController' {
        technology 'Infrastructure · REST'
        description 'POST /accounts · GET /accounts · GET /accounts/{id} · GET /accounts/{id}/balance · POST /accounts/{id}/rename · POST /accounts/{id}/close'
      }
      ledgerController = component 'LedgerController' {
        technology 'Infrastructure · REST'
        description 'POST /ledger/initialize · GET /ledger/settings. Ciclo de vida a nivel ledger: inicializacion (crea las cuentas tecnicas de sistema) y lectura de settings. Las mutaciones de settings pertenecen a EP-4.'
        metadata {
          introducedIn 'hu-0013'
        }
      }
      treeProjector = component 'AccountTreeProjector' {
        technology 'Infrastructure · Projector'
        description 'Construye la proyeccion proj_accounts (arbol de cuentas).'
      }
    }
  }

  // Relaciones estructurales
  admin.ledger.accounts.account -> admin.ledger.accounts.accountEvents 'emite'
  admin.ledger.accounts.account -> admin.ledger.accounts.accountException 'valida con'
  admin.ledger.accounts.accountRepository -> admin.ledger.accounts.account 'rehidrata / persiste'
  admin.ledger.accounts.openHandler -> admin.ledger.accounts.accountRepository 'usa'
  admin.ledger.accounts.renameHandler -> admin.ledger.accounts.accountRepository 'usa'
  admin.ledger.accounts.closeHandler -> admin.ledger.accounts.accountRepository 'usa'
  admin.ledger.accounts.accountValidation -> admin.ledger.accounts.account 'valida'
  admin.ledger.accounts.controller -> admin.ledger.shared.commandBus 'despacha commands'
  admin.ledger.accounts.controller -> admin.ledger.shared.queryBus 'lecturas'
  admin.ledger.accounts.ledgerController -> admin.ledger.shared.commandBus 'dispatch(InitializeLedgerCommand)'
  admin.ledger.accounts.ledgerController -> admin.ledger.shared.queryBus 'ask(GetLedgerSettingsQuery)'
  admin.ledger.accounts.ledgerController -> admin.ledger.shared.commandBus 'dispatch(ReplaceLedgerSettingsCommand)'
  admin.ledger.accounts.treeProjector -> admin.ledger.shared.eventStore 'consume eventos'
  admin.ledger.accounts.initializeHandler -> admin.ledger.shared.commandBus 'dispatch(OpenSystemAccountCommand) x2, dentro de withTransaction'
  admin.ledger.accounts.openSystemHandler -> admin.ledger.accounts.account 'Account.open({ isSystem: true })'
  admin.ledger.accounts.openSystemHandler -> admin.ledger.accounts.accountRepository 'save(account)'
}

views 'Accounts' {
  view accountsComponents of admin.ledger.accounts {
    title 'Componentes'
    include admin.ledger.accounts, admin.ledger.accounts.*
    include admin.ledger.shared.commandBus, admin.ledger.shared.queryBus, admin.ledger.shared.eventStore
  }

  // --- Dynamic views (un flujo por caso de uso) ---

  dynamic view openAccount {
    title 'Abrir cuenta · trigger REST'
    user -> admin.ledger.accounts.controller 'POST /accounts (OpenAccountRequestDto)'
    admin.ledger.accounts.controller -> admin.ledger.shared.commandBus 'dispatch(OpenAccountCommand)'
    admin.ledger.shared.commandBus -> admin.ledger.accounts.openHandler 'handle'
    admin.ledger.accounts.openHandler -> admin.ledger.accounts.account 'Account.open(id, name, currencies, openedOn) — valida AC-2'
    admin.ledger.accounts.account -> admin.ledger.accounts.accountEvents 'raise(AccountOpened)'
    admin.ledger.accounts.openHandler -> admin.ledger.accounts.accountRepository 'save(account)'
    admin.ledger.accounts.accountRepository -> admin.ledger.shared.eventStore 'append(AccountOpened)'
  }

  dynamic view renameAccount {
    title 'Renombrar cuenta · trigger REST'
    user -> admin.ledger.accounts.controller 'POST /accounts/{id}/rename (RenameAccountRequestDto)'
    admin.ledger.accounts.controller -> admin.ledger.shared.commandBus 'dispatch(RenameAccountCommand)'
    admin.ledger.shared.commandBus -> admin.ledger.accounts.renameHandler 'handle'
    admin.ledger.accounts.renameHandler -> admin.ledger.accounts.accountRepository 'load(id)'
    admin.ledger.accounts.renameHandler -> admin.ledger.accounts.account 'rename(newName) — INV-13 / INV-14'
    admin.ledger.accounts.account -> admin.ledger.accounts.accountEvents 'raise(AccountRenamed)'
    admin.ledger.accounts.renameHandler -> admin.ledger.accounts.accountRepository 'save(account)'
    admin.ledger.accounts.accountRepository -> admin.ledger.shared.eventStore 'append(AccountRenamed)'
  }

  dynamic view closeAccount {
    title 'Cerrar cuenta · trigger REST'
    user -> admin.ledger.accounts.controller 'POST /accounts/{id}/close (CloseAccountRequestDto)'
    admin.ledger.accounts.controller -> admin.ledger.shared.commandBus 'dispatch(CloseAccountCommand)'
    admin.ledger.shared.commandBus -> admin.ledger.accounts.closeHandler 'handle'
    admin.ledger.accounts.closeHandler -> admin.ledger.accounts.accountRepository 'load(id)'
    admin.ledger.accounts.closeHandler -> admin.ledger.accounts.account 'close(closedOn) — INV-13'
    admin.ledger.accounts.account -> admin.ledger.accounts.accountEvents 'raise(AccountClosed)'
    admin.ledger.accounts.closeHandler -> admin.ledger.accounts.accountRepository 'save(account)'
    admin.ledger.accounts.accountRepository -> admin.ledger.shared.eventStore 'append(AccountClosed)'
  }

  // --- Dynamic views: queries (trigger REST) ---

  dynamic view listAccounts {
    title 'Listar cuentas (lista plana) · trigger REST'
    description 'El parametro ?view=tree|flat se valida pero se ignora: la respuesta es siempre la lista plana ordenada por nombre (hu-0013, AC-4).'
    user -> admin.ledger.accounts.controller 'GET /accounts (?view se ignora)'
    admin.ledger.accounts.controller -> admin.ledger.shared.queryBus 'ask(GetAccountTreeQuery, ctx)'
    admin.ledger.shared.queryBus -> admin.ledger.shared.readModel 'query proj_accounts por userId, order name ASC'
  }

  dynamic view getAccountBalances {
    title 'Consultar saldos · trigger REST'
    user -> admin.ledger.accounts.controller 'GET /accounts/{id}/balance (?currency se ignora)'
    admin.ledger.accounts.controller -> admin.ledger.shared.queryBus 'ask(GetAccountBalancesQuery, ctx)'
    admin.ledger.shared.queryBus -> admin.ledger.shared.readModel 'query proj_accounts para owned IDs'
    admin.ledger.shared.queryBus -> admin.ledger.shared.readModel 'query proj_balances filtrado por owned'
  }

  dynamic view getAccountById {
    title 'Consultar una cuenta · trigger REST'
    description 'Una cuenta inexistente devuelve 200 con cuerpo null, no 404: el handler retorna row ?? null y ninguna capa lo traduce a excepcion (hu-0013, AC-4).'
    user -> admin.ledger.accounts.controller 'GET /accounts/{id}'
    admin.ledger.accounts.controller -> admin.ledger.shared.queryBus 'ask(GetAccountByIdQuery, ctx)'
    admin.ledger.shared.queryBus -> admin.ledger.shared.readModel 'query proj_accounts por userId + accountId'
  }

  // --- Dynamic views: ciclo de vida del ledger (hu-0013) ---

  dynamic view replaceLedgerSettings {
    title 'Reemplazar la configuracion del ledger · trigger REST'

    user -> admin.ledger.accounts.ledgerController 'PUT /ledger/settings (ReplaceLedgerSettingsRequestDto)'
    admin.ledger.accounts.ledgerController -> admin.ledger.shared.commandBus 'dispatch(ReplaceLedgerSettingsCommand)'
    admin.ledger.shared.commandBus -> admin.ledger.shared.eventStore 'append(PresentationCurrencyChanged + TimezoneChanged) — un solo append'
  }

  dynamic view initializeLedger {
    title 'Inicializar ledger · trigger REST'
    description 'Crea las cuentas tecnicas del sistema y fija la moneda de presentacion y la timezone. Las cuentas entran por el CommandBus como OpenSystemAccountCommand: el agregado Account pertenece a este modulo y no se construye desde otro. Los tres appends comparten un unico withTransaction (INV-7) y el dispatch de proyecciones queda fuera del scope.'
    user -> admin.ledger.accounts.ledgerController 'POST /ledger/initialize (InitializeLedgerRequestDto)'
    admin.ledger.accounts.ledgerController -> admin.ledger.shared.commandBus 'dispatch(InitializeLedgerCommand)'
    admin.ledger.shared.commandBus -> admin.ledger.accounts.initializeHandler 'handle — abre withTransaction'
    admin.ledger.accounts.initializeHandler -> admin.ledger.shared.commandBus 'dispatch(OpenSystemAccountCommand: Equity:OpeningBalances)'
    admin.ledger.shared.commandBus -> admin.ledger.accounts.openSystemHandler 'handle'
    admin.ledger.accounts.openSystemHandler -> admin.ledger.accounts.accountRepository 'save — append(AccountOpened)'
    admin.ledger.accounts.initializeHandler -> admin.ledger.shared.commandBus 'dispatch(OpenSystemAccountCommand: Equity:Adjustments)'
    admin.ledger.accounts.initializeHandler -> admin.ledger.shared.eventStore 'append(LedgerInitialized) con los dos accountId'
  }

  dynamic view getLedgerSettings {
    title 'Leer settings del ledger · trigger REST'
    description 'Lectura pura de la proyeccion de settings. Devuelve la fila cruda (snake_case), no un LedgerSettingsDto (hu-0013, AC-10).'
    user -> admin.ledger.accounts.ledgerController 'GET /ledger/settings'
    admin.ledger.accounts.ledgerController -> admin.ledger.shared.queryBus 'ask(GetLedgerSettingsQuery, ctx)'
    admin.ledger.shared.queryBus -> admin.ledger.shared.readModel 'query proj_ledger_settings por userId'
  }

  dynamic view recordOpeningBalance {
    title 'Registrar saldo inicial · trigger REST'
    description 'AC-4 (hu-0025): AccountsController construye RecordOpeningBalanceCommand desde el body (amount, currency, date, dryRun) y lo despacha al CommandBus. El handler resuelve Equity:OpeningBalances de los settings (INV-13). Con dryRun: true, DryRunPolicy ejecuta completo y revierte; RetryPolicy reintenta 40P01/40001.'
    user -> admin.ledger.accounts.controller 'POST /accounts/{id}/opening-balance'
    admin.ledger.accounts.controller -> admin.ledger.shared.commandBus 'despacha RecordOpeningBalanceCommand'
    admin.ledger.shared.commandBus -> admin.ledger.shared.dryRunPolicy 'si dryRun: true → ejecuta y revierte (AC-2/3)'
  }
}
