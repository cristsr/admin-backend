// C4 Nivel 3 — shared (apps/ledger) — HTTP adapter infrastructure.
// Extiende admin.ledger.shared definido en docs/architecture/landscape.c4.
// hu-0009: documenta el patrón controller->bus, Swagger/OpenAPI, y el kernel HTTP.
// hu-0024: idempotencia estricta (IDEMPOTENCY_INPUT_MISMATCH) y ctx contextual en el chain.

model {
  extend admin.ledger.shared {

    // --- HTTP kernel components (hu-0009) ---

    sharedHttpModule = component 'SharedHttpModule' {
      technology 'Infrastructure · NestJS'
      description '@Global() module que cablea CommandResultInterceptor, LedgerContextGuard (APP_GUARD), y LedgerContextResolver. Swap del resolver para cambiar el mecanismo de auth.'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    commandAcceptedDto = component 'CommandAcceptedDto' {
      technology 'Infrastructure · DTO'
      description '{ id: aggregateId, streamPosition: string (bigint serializado) }. static from(CommandResult). Jamás una vista de lectura (RNF-10).'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    commandResultInterceptor = component 'CommandResultInterceptor' {
      technology 'Infrastructure · NestInterceptor'
      description 'Intercepta la respuesta de toda escritura: CommandResult → CommandAcceptedDto, agrega header X-Ledger-Stream-Position, downgradea replays idempotentes a 200. Desde hu-0024 agrega Idempotency-Hit: true en el replay (AC-7).'
      metadata {
        introducedIn 'hu-0009'
        changedIn 'hu-0024'
      }
    }

    ledgerContextGuard = component 'LedgerContextGuard' {
      technology 'Infrastructure · NestJS Guard (APP_GUARD)'
      description 'RF-26: resuelve LedgerContext via LedgerContextResolver en cada request y lo adjunta al request. Rechaza 401 si no hay contexto; bypass @Public().'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    ledgerContextResolver = component 'LedgerContextResolver' {
      technology 'Application · Port (abstract class)'
      description 'Puerto abstracto para resolver el contexto autenticado. Implementado actualmente por GatewayHeaderContextResolver (headers x-user-id / x-client-id).'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    gatewayHeaderContextResolver = component 'GatewayHeaderContextResolver' {
      technology 'Infrastructure · Resolver'
      description 'Lee x-user-id y x-client-id de los headers HTTP. Swap por el mecanismo definitivo cuando se defina el servicio de identidad (hu-0010).'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    swaggerBuilder = component 'SwaggerBuilder' {
      technology 'Infrastructure · OpenAPI'
      description 'buildSwaggerDocument(): OpenAPIObject con title "Ledger API" v1.0.0 + esquemas gatewayContext (apiKey x-user-id) y bearerAuth (JWT). maybeMountSwagger(app, showDocs) monta Swagger UI en /api/docs si NODE_ENV !== production.'
      metadata {
        introducedIn 'hu-0009'
      }
    }

    // --- Idempotencia y read-your-writes (hu-0012, RF-11 / RNF-9) ---

    externalRefDecorator = component 'ExternalRef' {
      technology 'Infrastructure · Nest param decorator'
      description 'Extrae el idempotency key: header X-External-Ref preferido, fallback a external_ref del body, null si ninguno es string no vacío. El controller solo lo transporta; la semántica vive en el EventStore (INV-10).'
      metadata {
        introducedIn 'hu-0012'
      }
    }

    idempotencyPolicy = component 'IdempotencyPolicy' {
      technology 'Application · CommandPolicy (chain)'
      description 'Segunda política del command bus. Con externalRef presente busca el evento ancla por (user_id, external_ref); si existe replaya el CommandResult original sin ejecutar el handler. Desde hu-0024 compara el hash canónico de los inputs del command contra el external_ref_hash del ancla: coincide → replay; difiere → IDEMPOTENCY_INPUT_MISMATCH (409, AC-6).'
      metadata {
        introducedIn 'hu-0012'
        changedIn 'hu-0024'
      }
    }

    idempotencyInputMismatchException = component 'IdempotencyInputMismatchException' {
      technology 'Domain · Exception'
      description 'Extiende DomainConflictException, code IDEMPOTENCY_INPUT_MISMATCH (409). La lanza IdempotencyPolicy cuando una external_ref ya vista llega con inputs distintos. Convive con DUPLICATE_EXTERNAL_REF, que sigue siendo el contrato del puerto ante la violación del índice único.'
      metadata {
        introducedIn 'hu-0024'
      }
    }

    // --- Contrato de errores de dominio (hu-0011, RF-14) ---

    exceptionFilter = component 'ExceptionFilter' {
      technology 'Infrastructure · @Catch() ExceptionFilter (@shared)'
      description 'Filter global registrado en main.ts: DomainException → ErrorResponseBody { statusCode, error, message, code, path, timestamp } con exception.status y exception.code verbatim; HttpException pasa tal cual; error no tipado → 500 sin code.'
      metadata {
        introducedIn 'hu-0011'
      }
    }

    ledgerErrorCode = component 'LEDGER_ERROR_CODE' {
      technology 'Domain · const (fuente única RF-14)'
      description 'apps/ledger/src/shared/domain/errors/ledger-error-code.ts: única fuente de los strings de code que el API expone. Agregar un code es aditivo; cambiar el status de un code existente es breaking (nueva versión).'
      metadata {
        introducedIn 'hu-0011'
      }
    }

    // --- Relaciones del kernel HTTP ---

    admin.ledger.shared.sharedHttpModule -> admin.ledger.shared.commandResultInterceptor 'provides'
    admin.ledger.shared.sharedHttpModule -> admin.ledger.shared.ledgerContextGuard 'provides APP_GUARD'
    admin.ledger.shared.sharedHttpModule -> admin.ledger.shared.ledgerContextResolver 'provides (useClass: GatewayHeaderContextResolver)'

    admin.ledger.shared.gatewayHeaderContextResolver -> admin.ledger.shared.ledgerContextResolver 'implements'

    admin.ledger.shared.commandResultInterceptor -> admin.ledger.shared.commandAcceptedDto 'maps CommandResult to'
    admin.ledger.shared.commandResultInterceptor -> admin.ledger.shared.commandBus 'intercepts response of dispatched commands'

    // --- Relaciones de idempotencia (hu-0012) ---

    admin.ledger.shared.externalRefDecorator -> admin.ledger.shared.commandBus 'aporta externalRef al AuthContext'
    admin.ledger.shared.commandBus -> admin.ledger.shared.idempotencyPolicy 'delega el chain de políticas'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.commandResultInterceptor 'CommandResult (idempotentReplay) → 200 + header'

    // --- Relaciones de idempotencia estricta (hu-0024) ---

    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.canonicalHash 'hashea los inputs del command (sin metadatos de transporte)'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'lanza si el hash almacenado difiere'

    // --- Relaciones del contrato de errores (hu-0011) ---

    admin.ledger.shared.commandBus -> admin.ledger.shared.exceptionFilter 'DomainException burbujea desde handlers/policies'
    admin.ledger.shared.queryBus -> admin.ledger.shared.exceptionFilter 'DomainException burbujea desde queries'
    admin.ledger.shared.exceptionFilter -> admin.ledger.shared.ledgerErrorCode 'expone exception.code verbatim (RF-14)'
  }

  extend admin.ledger.shared.commandBus {
    metadata {
      changedIn 'hu-0024'
    }
  }
}

views 'Shared · HTTP adapter' {
  // Vista estática de todos los componentes del kernel HTTP + buses
  view shared_http_kernel of admin.ledger.shared {
    title 'Kernel HTTP'
    include admin.ledger.shared, admin.ledger.shared.*
  }

  // Flujo de dispatch de un command via HTTP
  dynamic view shared_http_command_dispatch {
    title 'POST /api/v1/* → CommandBus · trigger: rest'
    description 'AC-4, AC-5, AC-6: el controller construye un command desde headers (@Context, @ExternalRef) + body, lo despacha al CommandBus, y CommandResultInterceptor transforma el resultado en CommandAcceptedDto.'

    admin.ledger.shared.ledgerContextGuard -> admin.ledger.shared.ledgerContextResolver 'resolve context'
    admin.ledger.shared.ledgerContextResolver -> admin.ledger.shared.gatewayHeaderContextResolver 'reads x-user-id, x-client-id'

    admin.ledger.shared.commandBus -> admin.ledger.shared.commandResultInterceptor 'returns CommandResult'
    admin.ledger.shared.commandResultInterceptor -> admin.ledger.shared.commandAcceptedDto 'maps to { id, streamPosition }'

    autoLayout LeftRight
  }

  // Flujo de consulta via HTTP
  dynamic view shared_http_query_dispatch {
    title 'GET /api/v1/* → QueryBus · trigger: rest'
    description 'AC-4: el controller construye un query desde el contexto y parámetros y lo pregunta al QueryBus. La respuesta se devuelve sin transformar.'

    admin.ledger.shared.ledgerContextGuard -> admin.ledger.shared.ledgerContextResolver 'resolve context'
    admin.ledger.shared.ledgerContextResolver -> admin.ledger.shared.gatewayHeaderContextResolver 'reads x-user-id'

    autoLayout TopBottom
  }

  // Montaje de Swagger en bootstrap
  dynamic view shared_swagger_docs {
    title 'GET /api/docs (Swagger UI) · trigger: rest'
    description 'AC-2: SwaggerBuilder.maybeMountSwagger monta Swagger UI en /api/docs cuando NODE_ENV !== "production". El documento OpenAPI incluye los esquemas gatewayContext (apiKey) y bearerAuth (JWT) con gatewayContext como default.'

    admin.ledger.shared.swaggerBuilder -> admin.ledger.shared.commandBus 'documents bus contract'
    admin.ledger.shared.swaggerBuilder -> admin.ledger.shared.queryBus 'documents bus contract'

    autoLayout TopBottom
  }

  // Escritura idempotente por external_ref + read-your-writes (hu-0012, hu-0024)
  dynamic view shared_http_idempotent_write {
    title 'POST /api/v1/* con X-External-Ref → replay o 409 · trigger: rest'
    description 'AC-5, AC-6, AC-7: IdempotencyPolicy hashea los inputs del command (Command + userId, sin external_ref, client_id ni metadatos de transporte) y lo compara contra el external_ref_hash del evento ancla. Coincide → replay del CommandResult original con 200 y cabecera Idempotency-Hit: true. No coincide → IDEMPOTENCY_INPUT_MISMATCH (409). El hash viaja al ancla por el AuthContext, que ahora atraviesa el chain de políticas.'

    admin.ledger.shared.externalRefDecorator -> admin.ledger.shared.commandBus 'externalRef en AuthContext'
    admin.ledger.shared.commandBus -> admin.ledger.shared.idempotencyPolicy 'dispatch atraviesa el chain (ctx contextual)'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.canonicalHash 'hash de los inputs del command'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'inputs distintos → 409'
    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.commandResultInterceptor 'inputs iguales → CommandResult del ancla'
    admin.ledger.shared.commandResultInterceptor -> admin.ledger.shared.commandAcceptedDto '200 + Idempotency-Hit: true + X-Ledger-Stream-Position'

    autoLayout TopBottom
  }

  // Mapeo de errores de dominio/puerto al cuerpo de error uniforme (RF-14, hu-0024)
  dynamic view shared_http_map_domain_error {
    title 'Fallo de dominio/puerto → ErrorResponseBody con code estable · trigger: rest'
    description 'RF-14 + AC-6 de hu-0024: se suma IDEMPOTENCY_INPUT_MISMATCH (409) a la tabla congelada de códigos. Reparto por capa: el código nuevo es el contrato de IdempotencyPolicy y el único de los dos que el API HTTP emite; DUPLICATE_EXTERNAL_REF se queda como contrato del puerto EventStore ante la violación del índice único.'

    admin.ledger.shared.idempotencyPolicy -> admin.ledger.shared.idempotencyInputMismatchException 'throws IDEMPOTENCY_INPUT_MISMATCH'

    autoLayout TopBottom
  }
}
