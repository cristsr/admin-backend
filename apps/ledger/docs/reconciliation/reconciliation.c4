// C4 Nivel 3 — modulo reconciliation (apps/ledger/src/reconciliation).
// Extiende admin.ledger definido en docs/architecture/landscape.c4.
// Acumula: hu-0015 (persistencia Postgres de las proyecciones + pump con checkpoint).
//
// admin.ledger.shared.readModel y .projectionDispatcher viven en shared-kernel.c4:
// se referencian, no se redefinen.

model {
  extend admin.ledger {
    reconciliation = module 'Reconciliation' {
      description 'Afirmaciones de saldo, evaluacion, revocacion y resolucion de discrepancias.'
      metadata {
        introducedIn 'hu-0015'
      }

      // --- Driving adapter + application handlers ---
      controller = component 'BalanceAssertionController' {
        technology 'Infrastructure · REST'
        description 'POST / · POST /{id}/revoke · POST /{id}/resolve · GET /{id} · GET /'
        metadata {
          introducedIn 'hu-0017'
        }
      }
      assertHandler = component 'AssertBalanceHandler' {
        technology 'Application · CommandHandler'
        description 'Registra la asercion (RF-17). No evalua: eso es asincrono.'
        metadata {
          introducedIn 'hu-0017'
        }
      }
      revokeHandler = component 'RevokeAssertionHandler' {
        technology 'Application · CommandHandler'
        description 'Revoca con motivo auditado (RF-19). Terminal.'
        metadata {
          introducedIn 'hu-0017'
        }
      }
      resolveHandler = component 'ResolveDiscrepancyHandler' {
        technology 'Application · CommandHandler'
        description 'Ajuste contra Equity:Adjustments via RecordTransaction (RF-20).'
        metadata {
          introducedIn 'hu-0017'
        }
      }
      statusQuery = component 'GetAssertionStatusHandler' {
        technology 'Application · QueryHandler'
        description 'Lee una asercion de proj_assertions.'
        metadata {
          introducedIn 'hu-0017'
        }
      }
      listQuery = component 'ListAssertionsHandler' {
        technology 'Application · QueryHandler'
        description 'Lista las aserciones de una cuenta, revocadas incluidas.'
        metadata {
          introducedIn 'hu-0017'
        }
      }

      // --- Domain ---
      balanceAssertion = component 'BalanceAssertion' {
        technology 'Domain · Aggregate'
        description 'assert / evaluate / revoke / resolve. Event-sourced.'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      assertionStatusStore = component 'AssertionStatusStore' {
        technology 'Domain · Port (solo lectura)'
        description 'byId, listByAccount, nonRevokedOnAccountFrom sobre proj_assertions.'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      adjustmentAuditStore = component 'AdjustmentAuditStore' {
        technology 'Domain · Port (solo lectura)'
        description 'byAccount sobre proj_adjustment_audit.'
        metadata {
          introducedIn 'hu-0015'
        }
      }

      // --- Application ---
      reevaluateReactor = component 'ReevaluateAssertionsReactor' {
        technology 'Application · Reactor'
        description 'Despacha EvaluateAssertion sobre las aserciones afectadas (RF-18). Nunca escribe.'
        metadata {
          introducedIn 'hu-0015'
          changedIn 'hu-0016'
        }
      }

      // --- Infrastructure ---
      assertionStatusProjector = component 'AssertionStatusProjector' {
        technology 'Infrastructure · Projector'
        description 'Materializa proj_assertions. Extiende Projector; escribe por ReadModelStore.'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      adjustmentAuditProjector = component 'AdjustmentAuditProjector' {
        technology 'Infrastructure · Projector'
        description 'Materializa proj_adjustment_audit(_entries) desde DiscrepancyResolved.'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      reconciliationPump = component 'ReconciliationPump' {
        technology 'Infrastructure · Scheduled poller'
        description 'Lee el stream desde el checkpoint; proyecta y luego alimenta al reactor.'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      assertionPostingReader = component 'AssertionPostingReader' {
        technology 'Domain · Port (solo lectura)'
        description 'Postings de una cuenta hasta un corte, y cuentas tocadas por una transaccion.'
        metadata {
          introducedIn 'hu-0016'
        }
      }
      postingReaderAdapter = component 'ReadModelAssertionPostingReader' {
        technology 'Infrastructure · Adapter'
        description 'Implementa AssertionPostingReader sobre proj_postings via ReadModelStore.'
        metadata {
          introducedIn 'hu-0016'
        }
      }
      assertionStatusReader = component 'ReadModelAssertionStatusReader' {
        technology 'Infrastructure · Adapter'
        description 'Implementa AssertionStatusStore sobre ReadModelStore.query(proj_assertions).'
        metadata {
          introducedIn 'hu-0015'
        }
      }
      adjustmentAuditReader = component 'ReadModelAdjustmentAuditReader' {
        technology 'Infrastructure · Adapter'
        description 'Implementa AdjustmentAuditStore sobre ReadModelStore.query(proj_adjustment_audit).'
        metadata {
          introducedIn 'hu-0015'
        }
      }
    }
  }

  extend admin.ledger.shared {
    projectionCheckpoints = store 'ProjectionCheckpoints' {
      technology 'PostgreSQL'
      description 'Posicion global por proyeccion; habilita reanudar y medir lag (RNF-12).'
      metadata {
        introducedIn 'hu-0015'
      }
    }
    postgresCheckpointRepository = component 'PostgresProjectionCheckpointRepository' {
      technology 'Infrastructure · PostgreSQL'
      description 'Primer adaptador real de ProjectionCheckpointRepository; usa projection_checkpoints.'
      metadata {
        introducedIn 'hu-0015'
      }
    }
  }

  // Relaciones estructurales (fuera del extend, como en transactions.c4)
  admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.eventStore 'readAll(checkpoint, 100)'
  admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.assertionStatusProjector 'project(event, store)'
  admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.adjustmentAuditProjector 'project(event, store)'
  admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.reevaluateReactor 'on(event) tras proyectar'
  admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.postgresCheckpointRepository 'advance(globalPosition)'
  admin.ledger.reconciliation.assertionStatusProjector -> admin.ledger.shared.readModel 'upsert proj_assertions'
  admin.ledger.reconciliation.adjustmentAuditProjector -> admin.ledger.shared.readModel 'query + upsert proj_adjustment_audit(_entries)'
  user -> admin.ledger.reconciliation.controller 'concilia via HTTP/REST'
  admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.assertHandler 'POST /balance-assertions'
  admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.revokeHandler 'POST /{id}/revoke'
  admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.resolveHandler 'POST /{id}/resolve'
  admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.statusQuery 'GET /{id}'
  admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.listQuery 'GET /'
  admin.ledger.reconciliation.assertHandler -> admin.ledger.reconciliation.balanceAssertion 'assert()'
  admin.ledger.reconciliation.revokeHandler -> admin.ledger.reconciliation.balanceAssertion 'revoke(reason)'
  admin.ledger.reconciliation.resolveHandler -> admin.ledger.shared.commandBus 'dispatch(RecordTransaction) del ajuste'
  admin.ledger.reconciliation.resolveHandler -> admin.ledger.reconciliation.balanceAssertion 'resolve(adjustmentTxnId)'
  admin.ledger.reconciliation.statusQuery -> admin.ledger.reconciliation.assertionStatusStore 'byId'
  admin.ledger.reconciliation.listQuery -> admin.ledger.reconciliation.assertionStatusStore 'listByAccount'
  admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.reconciliation.assertionPostingReader 'cuentas tocadas por la transaccion anulada'
  admin.ledger.reconciliation.postingReaderAdapter -> admin.ledger.reconciliation.assertionPostingReader 'implementa'
  admin.ledger.reconciliation.postingReaderAdapter -> admin.ledger.shared.readModel 'query proj_postings'
  admin.ledger.reconciliation.assertionStatusReader -> admin.ledger.shared.readModel 'query proj_assertions'
  admin.ledger.reconciliation.adjustmentAuditReader -> admin.ledger.shared.readModel 'query proj_adjustment_audit'
  admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.reconciliation.assertionStatusStore 'aserciones afectadas'
  admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.shared.commandBus 'dispatch(EvaluateAssertion)'
  admin.ledger.shared.postgresCheckpointRepository -> admin.ledger.shared.projectionCheckpoints 'lee / avanza'
  admin.ledger.reconciliation.assertionStatusReader -> admin.ledger.reconciliation.assertionStatusStore 'implementa'
  admin.ledger.reconciliation.adjustmentAuditReader -> admin.ledger.reconciliation.adjustmentAuditStore 'implementa'
}

views 'Reconciliation' {
  view reconciliationComponents of admin.ledger.reconciliation {
    title 'Componentes'
    include admin.ledger.reconciliation, admin.ledger.reconciliation.*
    include admin.ledger.shared.readModel, admin.ledger.shared.eventStore, admin.ledger.shared.commandBus
  }

  dynamic view assertBalance {
    title 'Afirmar un saldo · trigger REST'

    user -> admin.ledger.reconciliation.controller 'POST /v1/balance-assertions (AssertBalanceRequest)'
    admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.assertHandler 'AssertBalanceCommand + AuthContext'
    admin.ledger.reconciliation.assertHandler -> admin.ledger.reconciliation.balanceAssertion 'assert() — moneda vs cuenta'
    admin.ledger.reconciliation.assertHandler -> admin.ledger.shared.eventStore 'append(BalanceAsserted)'
  }

  dynamic view revokeAssertion {
    title 'Revocar una asercion erronea · trigger REST'

    user -> admin.ledger.reconciliation.controller 'POST /v1/balance-assertions/{id}/revoke'
    admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.revokeHandler 'RevokeAssertionCommand + AuthContext'
    admin.ledger.reconciliation.revokeHandler -> admin.ledger.reconciliation.balanceAssertion 'revoke(reason) — terminal'
    admin.ledger.reconciliation.revokeHandler -> admin.ledger.shared.eventStore 'append(AssertionRevoked)'
  }

  dynamic view resolveDiscrepancy {
    title 'Resolver una discrepancia con un ajuste · trigger REST'

    user -> admin.ledger.reconciliation.controller 'POST /v1/balance-assertions/{id}/resolve'
    admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.resolveHandler 'ResolveDiscrepancyCommand + AuthContext'
    admin.ledger.reconciliation.resolveHandler -> admin.ledger.shared.commandBus 'dispatch(RecordTransaction) contra Equity:Adjustments'
    admin.ledger.reconciliation.resolveHandler -> admin.ledger.reconciliation.balanceAssertion 'resolve(adjustmentTxnId)'
    admin.ledger.reconciliation.resolveHandler -> admin.ledger.shared.eventStore 'append(DiscrepancyResolved)'
  }

  dynamic view getAssertionStatus {
    title 'Consultar el estado de una asercion · trigger REST'

    user -> admin.ledger.reconciliation.controller 'GET /v1/balance-assertions/{id}'
    admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.statusQuery 'GetAssertionStatusQuery'
    admin.ledger.reconciliation.statusQuery -> admin.ledger.reconciliation.assertionStatusStore 'byId(userId, id)'
    admin.ledger.reconciliation.assertionStatusReader -> admin.ledger.shared.readModel 'query proj_assertions'
  }

  dynamic view listAssertions {
    title 'Listar las aserciones de una cuenta · trigger REST'

    user -> admin.ledger.reconciliation.controller 'GET /v1/balance-assertions?accountId='
    admin.ledger.reconciliation.controller -> admin.ledger.reconciliation.listQuery 'ListAssertionsQuery'
    admin.ledger.reconciliation.listQuery -> admin.ledger.reconciliation.assertionStatusStore 'listByAccount(userId, accountId)'
    admin.ledger.reconciliation.assertionStatusReader -> admin.ledger.shared.readModel 'query proj_assertions'
  }

  dynamic view projectAssertionStatus {
    title 'Proyectar assertion_status · trigger domain-event'

    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.eventStore 'readAll(checkpoint, 100)'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.assertionStatusProjector 'project(event, store)'
    admin.ledger.reconciliation.assertionStatusProjector -> admin.ledger.shared.readModel 'upsert proj_assertions'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.postgresCheckpointRepository 'advance(globalPosition)'
  }

  dynamic view projectAdjustmentAudit {
    title 'Proyectar adjustment_audit · trigger domain-event'

    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.adjustmentAuditProjector 'project(DiscrepancyResolved, store)'
    admin.ledger.reconciliation.adjustmentAuditProjector -> admin.ledger.shared.readModel 'query proj_assertions (difference, cuenta)'
    admin.ledger.reconciliation.adjustmentAuditProjector -> admin.ledger.shared.readModel 'upsert proj_adjustment_audit_entries'
    admin.ledger.reconciliation.adjustmentAuditProjector -> admin.ledger.shared.readModel 'upsert proj_adjustment_audit (recalculado)'
  }

  dynamic view reevaluateAssertions {
    title 'Re-evaluar aserciones tras una anulacion · trigger domain-event'

    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.reevaluateReactor 'on(TransactionVoided)'
    admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.reconciliation.assertionPostingReader 'touchedByTransaction(txnId)'
    admin.ledger.reconciliation.assertionPostingReader -> admin.ledger.shared.readModel 'query proj_postings por transaction_id'
    admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.reconciliation.assertionStatusStore 'nonRevokedOnAccountFrom(cuenta, fecha)'
    admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.shared.commandBus 'dispatch(EvaluateAssertion) por asercion'
    admin.ledger.shared.commandBus -> admin.ledger.reconciliation.balanceAssertion 'evaluate() — silencioso si el veredicto no cambia'
  }

  dynamic view runReconciliationPump {
    title 'Bombear el stream de conciliacion · trigger cron'

    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.postgresCheckpointRepository 'lastPosition(reconciliation)'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.eventStore 'readAll(from, 100)'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.assertionStatusProjector 'project'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.adjustmentAuditProjector 'project'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.reconciliation.reevaluateReactor 'on(event)'
    admin.ledger.reconciliation.reevaluateReactor -> admin.ledger.shared.commandBus 'dispatch(EvaluateAssertion)'
    admin.ledger.reconciliation.reconciliationPump -> admin.ledger.shared.postgresCheckpointRepository 'advance(globalPosition)'
  }
}
