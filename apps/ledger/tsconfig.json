{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@shared": ["libs/shared/src/index.ts"],
      "@shared/*": ["libs/shared/src/*"],
      "@ledger/*": ["apps/ledger/src/*"]
    },
    // The event store models `global_position` as `bigint` (never `number`),
    // so BigInt literals and the global must be available. Node 22 supports
    // them natively; this raises only the ledger app above the es2017 base.
    "target": "es2021",
    "lib": ["es2021"],
    "ignoreDeprecations": "6.0",
    // `big.js` is a CJS `export =` package; the `Money` value object imports it
    // with a default import, which requires the interop helper. Scoped to this
    // project — the base config keeps `esModuleInterop: false`.
    "esModuleInterop": true
  }
}
